# Copy to .env (git-ignored). No values for secrets. Blank values are treated as unset.
META_API_KEY=
META_MODEL=
META_BASE_URL=
# Optional ordered fallback: these three lists must have the same length when set.
META_FALLBACK_MODELS=
META_FALLBACK_BASE_URLS=
META_FALLBACK_API_KEYS=
META_TIMEOUT_MS=
META_MAX_RETRIES=
META_RETRY_BASE_MS=
META_MAX_CALLS_PER_RUN=
MUSE_BINARY_PATH=
RIPPLEWITNESS_HOME=
RIPPLEWITNESS_PORT=
RIPPLEWITNESS_LOCKED_RUN=
RIPPLEWITNESS_AGENT_SESSION=
RIPPLEWITNESS_LIVE=
RIPPLEWITNESS_LOG_LEVEL=
RIPPLEWITNESS_NO_CACHE=
# Subject-app contract (TRD §7.3.1), set per replayed app:
# PORT= DB_PATH= FROZEN_TIME= SEED= EXTERNAL_MODE= OUTBOUND_LOG=
