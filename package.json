{
  "name": "ripplewitness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @ripplewitness/server --filter @ripplewitness/web run dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:cov": "vitest run --config vitest.coverage.config.ts --coverage",
    "eval": "corepack pnpm --filter @ripplewitness/eval run start",
    "demo:prepare": "corepack pnpm --filter shop-api exec tsx src/seed.ts seed/seed.db",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "22",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vitest": "2.1.8"
  }
}
