{
  "id": "journey-regular",
  "group": "journey",
  "routeIds": [
    "route:GET /inventory/:sku",
    "route:POST /cart",
    "route:POST /checkout",
    "route:GET /shipping/quote"
  ],
  "steps": [
    {
      "method": "GET",
      "path": "/inventory/SKU-2"
    },
    {
      "method": "POST",
      "path": "/cart",
      "body": {
        "user": "regular-1",
        "items": [
          {
            "sku": "SKU-2",
            "qty": 1
          }
        ]
      },
      "capture": {
        "cartId": "$.id"
      }
    },
    {
      "method": "POST",
      "path": "/checkout",
      "body": {
        "cartId": "{{cartId}}",
        "user": "regular-1"
      }
    },
    {
      "method": "GET",
      "path": "/shipping/quote?subtotal=1500"
    }
  ]
}
